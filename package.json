{
  "name": "threshold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THRESHOLD — an original first-person browser horror game set in The Meridian.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sim": "tsx scripts/simulate.ts",
    "buildcheck": "tsx scripts/buildcheck.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "^20.19.43",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "jsdom": "^25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
